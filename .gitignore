.codebuddy/

# ---------- 测试类与测试资源 (生产环境不需要) ----------
/tests/
/backend/src/test/
/admin/src/**/*.test.ts
/admin/src/**/*.test.tsx
/admin/scripts/
/admin/temp-test/
/miniapp/tests/
/miniapp-rider/tests/

# ---------- 开发文档与本地规格说明 ----------
/docs/

# ---------- IDE ----------
.idea/
.vscode/
*.iml

# ---------- 编译输出与构建产物 ----------
/backend/target/
/backend/build/
/admin/dist/
/admin/admin-build-verify.log
/admin/admin-build.log
/admin/admin-helper-test.log
/admin/admin-test.log
# 通用构建/缓存目录
dist/
build/
out/
.output/
coverage/
.turbo/
.cache/
# 编译中间文件
*.class
*.jar
*.map
*.tsbuildinfo

# ---------- 日志 ----------
*.log
*.out
*.err
backend/*.log
backend/*.out
backend/*.err
admin/*.log
backend/*.txt

# ---------- 临时文件 ----------
*.tmp
*.temp
/split_*.js
/ui-assessment/
/ui_optimization_plan.md
backend/tmp_*

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db

# ---------- Node modules ----------
node_modules/
/admin/node_modules/

# ---------- Docker env ----------
.env
.env.local
.env.*.local

# ---------- Backend 本地配置 ----------
/backend/src/main/resources/application-local.yml

# ---------- 小程序开发工具 ----------
.miniprogram/
project.private.config.json

# ---------- 质量/分析工具产物 (本地生成，不应提交) ----------
