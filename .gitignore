# ---------- 上传的文件 / 运行时产出 ----------
/uploads/
/backend/uploads/
/backend/.backup/

# 恢复与备份
/_recovery/

# ---------- AI & 工具产物 (Trae/Superpowers/CodeBuddy 等) ----------
/.trae/
/.superpowers/
/.kiro/
/.claude/
/.worktrees/
/.worktree-backups/
/docs/superpowers/
.trae-sandbox/
