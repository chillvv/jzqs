# ============================================================
# jzqs 项目 .gitignore
# 多模块工程：Java 后端 / React 管理端 / 微信小程序 x2 / 云函数
# ============================================================

# ---------- 上传的文件 / 运行时产出 ----------
/uploads/
/backend/uploads/
/backend/.backup/

# 恢复与备份
/_recovery/

# ---------- AI & 工具产物 (Trae/Superpowers/CodeBuddy 等) ----------
/.trae/
/.superpowers/
/.kiro/
/.claude/
/.worktrees/
/.worktree-backups/
/docs/superpowers/
.trae-sandbox/
# 本地工作记忆（不提交，含跨会话 agent 记忆，属个人本地状态）
.codebuddy/

# ---------- 测试与文档（2026-08-29 起不再忽略，老板拍板）----------
# 测试文件必须入库：否则 CI 在 checkout 后无测试可跑，违反铁律 3「CI 必须跑测试」。
# 曾忽略 /tests/ /backend/src/test/ admin 测试 /miniapp/tests/ /miniapp-rider/tests/ /docs/
# 生产构建不需要测试文件 → 排除逻辑改由各模块 .dockerignore 承担。

# ---------- IDE ----------
.idea/
.vscode/
*.iml

# ---------- 编译输出与构建产物 ----------
/backend/target/
/backend/build/
/admin/dist/
/admin/admin-build-verify.log
/admin/admin-build.log
/admin/admin-helper-test.log
/admin/admin-test.log
# 通用构建/缓存目录
dist/
build/
out/
.output/
coverage/
.turbo/
.cache/
# 编译中间文件
*.class
*.jar
*.map
*.tsbuildinfo

# ---------- 日志 ----------
*.log
*.out
*.err
backend/*.log
backend/*.out
backend/*.err
admin/*.log
backend/*.txt

# ---------- 临时文件 ----------
*.tmp
*.temp
/split_*.js
/ui-assessment/
/ui_optimization_plan.md
backend/tmp_*

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db

# ---------- Node modules ----------
node_modules/
/admin/node_modules/

# ---------- Docker env ----------
.env
.env.local
.env.*.local

# ---------- Backend 本地配置 ----------
/backend/src/main/resources/application-local.yml

# ---------- 小程序开发工具 ----------
.miniprogram/
project.private.config.json

# ---------- 质量/分析工具产物 (本地生成，不应提交) ----------
.quality-admin.json
DEAD_CODE_REPORT.md
err.txt
# Vitest 临时生成的配置文件
vitest.config.ts.timestamp-*
*.timestamp-*.mjs
