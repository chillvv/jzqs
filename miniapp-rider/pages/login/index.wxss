page {
  background: var(--surface);
  --brand-secondary: #f2f2f2;
  --text-link: #576b95;
}

.auth-page-shell {
  min-height: 100vh;
  max-height: 86vh;
  overflow-y: auto;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 0 60rpx calc(env(safe-area-inset-bottom) + 40rpx);
}

/* Top Section */
.auth-page-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 160rpx;
  margin-bottom: 80rpx;
}

.auth-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.auth-page-title {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--on-surface);
  margin-bottom: 16rpx;
}

.auth-page-subtitle {
  font-size: 28rpx;
  color: var(--on-surface-variant);
}

/* Middle Section */
.auth-page-main {
  flex: 1;
  width: 100%;
}

.auth-form-group {
  margin-bottom: 40rpx;
}

.auth-form-item {
  display: flex;
  align-items: center;
  height: 100rpx;
  border-bottom: 1rpx solid #eeeeee;
  transition: border-color 0.3s;
}

.auth-form-item:focus-within {
  border-bottom-color: var(--brand-primary);
}

.auth-form-input {
  flex: 1;
  font-size: 32rpx;
  color: var(--on-surface);
  height: 100%;
}

.auth-input-placeholder {
  color: #cccccc;
}

/* Buttons */
.auth-btn {
  width: 320rpx !important;
  min-width: 320rpx;
  max-width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  padding: 0;
  margin-bottom: 32rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.auth-btn::after {
  border: none;
}

.auth-btn-primary {
  background: var(--brand-primary);
  color: #ffffff;
}

.auth-btn-primary[disabled] {
  background: #93c5fd !important;
  color: #ffffff !important;
}

.auth-btn-secondary {
  background: var(--brand-secondary);
  color: var(--on-surface);
}

.auth-btn-secondary[disabled] {
  background: #f7f7f7 !important;
  color: #cccccc !important;
}

/* Links */
.auth-links {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 20rpx;
}

.auth-link {
  font-size: 28rpx;
  color: var(--text-link);
  padding: 10rpx 20rpx;
}

.auth-link-divider {
  font-size: 24rpx;
  color: #e5e5e5;
  margin: 0 10rpx;
}
