<!-- 骑手小程序 - 订单列表页 -->
<!-- 排序 v4：上移/下移按钮，零手势冲突、零原生组件 -->

<template name="orderCard">
  <view
    class="order-card {{item.itemStatus === 'DELIVERED' ? 'order-card-completed' : ''}}"
    data-item-id="{{item.detailItemId}}"
    data-status="{{item.itemStatus}}"
    bindtap="{{isEditMode ? '' : 'handleOrderTap'}}"
  >
    <!-- 绝对定位的右上角状态标签 -->
    <view class="order-card-status-tag {{item.itemStatus === 'DELIVERED' ? 'tag-completed' : 'tag-pending'}}">
      {{item.itemStatus === 'DELIVERED' ? '已完成' : '待配送'}}
    </view>

    <view class="order-card-content">
      <view class="order-card-header">
        <view class="order-badge-wrapper">
          <view class="order-badge {{item.itemStatus === 'DELIVERED' && currentStatusFilter === '' ? 'order-badge-completed' : ''}}">
            <text class="badge-prefix">#</text>{{index + 1}}
          </view>
        </view>

        <view class="order-info">
          <view class="order-name-row">
            <view class="order-name {{item.itemStatus === 'DELIVERED' ? 'order-name-completed' : ''}}">
              {{item.customerName}}
            </view>
            <view wx:if="{{item.needAttention}}" class="special-tag-inline">{{item.attentionLabel || '有备注'}}</view>
            <view wx:if="{{item.quantity > 1}}" class="quantity-badge">
              ×{{item.quantity}}
            </view>
          </view>

          <view class="order-address-inline {{item.itemStatus === 'DELIVERED' ? 'order-address-completed' : ''}}">
            <text class="address-icon-inline">📍</text>
            <text class="address-text-content {{!item.deliveryAddress ? 'no-address' : ''}}"><text wx:if="{{item.buildingInfo}}" class="building-info-text">{{item.buildingInfo}}</text>{{item.deliveryAddress || '地址未提供'}}</text>
          </view>
        </view>

        <view class="order-right" style="{{isEditMode && item.itemStatus !== 'DELIVERED' ? '' : 'display: none;'}}">
          <view class="sort-btn {{item.canMoveUp ? '' : 'sort-btn-disabled'}}" catchtap="moveItemUp" data-index="{{index}}">
            <text class="material-symbols-outlined">↑</text>
          </view>
          <view class="sort-btn {{item.canMoveDown ? '' : 'sort-btn-disabled'}}" catchtap="moveItemDown" data-index="{{index}}">
            <text class="material-symbols-outlined">↓</text>
          </view>
        </view>
      </view>

      <!-- 列表缩略图：已送达显示当天送达图，未送达显示地址参考图。排序态隐藏，且受"显示参考图"开关控制 -->
      <view wx:if="{{item.displayThumbUrl && !isEditMode && showReferenceImage}}" class="ref-thumb-wrap" catchtap="previewRefImage" data-url="{{item.displayThumbUrl}}">
        <image class="ref-thumb-img" src="{{item.displayThumbUrl}}" mode="aspectFill" lazy-load="{{true}}"></image>
        <view class="ref-thumb-tag">{{item.displayThumbLabel}}</view>
      </view>
    </view>
  </view>
</template>

<view class="page-container">

  <!-- TopAppBar -->
  <view class="header-bar" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
    <view class="header-left">
      <image class="header-logo" src="/assets/logo.jpeg" mode="aspectFit"></image>
      <text class="header-title">简知轻食</text>
      <view class="header-date" bindtap="openDatePicker">
        <text>{{currentDateTitle}} {{currentDateLabel}}</text>
        <text class="header-date-arrow">▼</text>
      </view>
    </view>
  </view>

  <!-- 可滚动区域 -->
  <scroll-view
    class="scroll-area"
    scroll-y="true"
    refresher-enabled="{{!isEditMode}}"
    refresher-triggered="{{refresherTriggered}}"
    bindrefresherrefresh="onScrollRefresh"
  >

  <!-- Review Banner (Pending Approval) -->
  <view wx:if="{{viewState === 'pending'}}" class="banner banner-warning">
    <text class="material-symbols-outlined banner-icon">i</text>
    <text class="banner-text">账号待审核，暂无法接单。</text>
  </view>

  <!-- Blocked Banner -->
  <view wx:elif="{{viewState === 'blocked'}}" class="banner banner-error">
    <text class="material-symbols-outlined banner-icon">!</text>
    <text class="banner-text">账号已停用，请联系站长。</text>
  </view>

  <view wx:elif="{{viewState === 'active'}}" class="main-content">

    <!-- Toggle & Stats -->
    <view class="toggle-section">
      <view class="toggle-row">
        <view class="toggle-container">
          <view class="toggle-bg {{currentMealPeriod === 'DINNER' ? 'toggle-right' : 'toggle-left'}}"></view>
          <view
            class="toggle-btn {{currentMealPeriod === 'LUNCH' ? 'active' : ''}}"
            data-period="LUNCH"
            bindtap="switchMealPeriod"
          >午餐</view>
          <view
            class="toggle-btn {{currentMealPeriod === 'DINNER' ? 'active' : ''}}"
            data-period="DINNER"
            bindtap="switchMealPeriod"
          >晚餐</view>
        </view>
        <view class="header-action-group">
          <view wx:if="{{currentStatusFilter !== 'DELIVERED'}}" class="edit-btn-inline" bindtap="toggleEditMode">
            <image class="edit-icon" src="{{isEditMode ? '/assets/icons/check.svg' : '/assets/icons/sort.svg'}}" mode="aspectFit"></image>
            <text class="edit-text">{{isEditMode ? '完成' : '排序'}}</text>
          </view>
          <view class="ref-toggle-btn-inline {{isEditMode ? 'header-action-disabled' : ''}}" bindtap="toggleShowReferenceImage">
            <image class="action-icon" src="{{showReferenceImage ? '/assets/icons/check.svg' : '/assets/icons/camera-color.svg'}}" mode="aspectFit"></image>
            <text class="edit-text">{{showReferenceImage ? '隐藏参考图' : '显示参考图'}}</text>
          </view>
        </view>
      </view>

      <view class="stats-bento">
        <view class="stat-item">
          <text class="stat-value">{{currentMealPeriod === 'LUNCH' ? lunchStats.totalCount : dinnerStats.totalCount}}</text>
          <text class="stat-label">总份数</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value text-success">{{currentMealPeriod === 'LUNCH' ? lunchStats.deliveredCount : dinnerStats.deliveredCount}}</text>
          <text class="stat-label">已完成</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value text-primary">{{currentMealPeriod === 'LUNCH' ? lunchStats.remainingCount : dinnerStats.remainingCount}}</text>
          <text class="stat-label">待配送</text>
        </view>
      </view>

      <!-- 状态筛选 -->
      <view class="status-filter-row">
        <view
          class="status-filter-chip {{currentStatusFilter === 'PENDING' ? 'chip-active-pending' : ''}}"
          data-filter="PENDING"
          bindtap="switchStatusFilter"
        >待配送</view>
        <view
          class="status-filter-chip {{currentStatusFilter === '' ? 'chip-active-all' : ''}}"
          data-filter=""
          bindtap="switchStatusFilter"
        >全部</view>
        <view
          class="status-filter-chip {{currentStatusFilter === 'DELIVERED' ? 'chip-active-delivered' : ''}}"
          data-filter="DELIVERED"
          bindtap="switchStatusFilter"
        >已完成</view>
      </view>
    </view>

    <!-- 编辑态提示 -->
    <view wx:if="{{isEditMode && currentMealItems.length > 0}}" class="drag-hint">
      <text class="material-symbols-outlined">↑↓</text>
      <text>点击右侧箭头调整配送顺序，已送达订单不参与排序。</text>
    </view>

    <!-- Orders List -->
    <view class="orders-list">
      <block wx:for="{{currentMealItems}}" wx:key="queueItemIdentity" wx:for-item="item" wx:for-index="index">
        <template is="orderCard" data="{{item: item, index: index, isEditMode: isEditMode, showReferenceImage: showReferenceImage, currentStatusFilter: currentStatusFilter}}" />
      </block>
    </view>

    <!-- 空状态 / 加载失败 -->
    <view wx:if="{{currentMealItems.length === 0 && !loading}}" class="empty-state">
      <view class="empty-icon">
        <text class="material-symbols-outlined" style="font-size: 96rpx;">{{queueError ? '⚠️' : '📭'}}</text>
      </view>
      <view class="empty-text">
        {{queueError ? (queueErrorMessage || '加载失败，请检查网络后重试') : (currentStatusFilter === 'PENDING' ? '暂无待配送订单' : currentStatusFilter === 'DELIVERED' ? '暂无已完成订单' : '暂无订单')}}
      </view>
      <view wx:if="{{queueError}}" class="empty-retry" bindtap="onScrollRefresh">
        <text class="empty-retry__text">点击重试</text>
      </view>
    </view>
  </view>
  </scroll-view>

  <!-- 编辑模式浮动完成按钮（fixed，不随 scroll-view 滚动） -->
  <view wx:if="{{isEditMode}}" class="edit-float-finish" bindtap="toggleEditMode">
    <text>完成保存</text>
  </view>

  <view wx:if="{{showDatePicker}}" class="date-picker-mask" bindtap="closeDatePicker"></view>
  <view wx:if="{{showDatePicker}}" class="date-picker-sheet">
    <view class="date-picker-sheet__header">
      <text class="date-picker-sheet__title">切换日期</text>
      <text class="date-picker-sheet__subtitle">仅支持昨天、今天、明天</text>
    </view>
    <view class="date-picker-options">
      <view
        wx:for="{{dateOptions}}"
        wx:key="value"
        class="date-picker-option {{item.active ? 'date-picker-option--active' : ''}}"
        data-date="{{item.value}}"
        bindtap="selectWorkbenchDate"
      >
        <text class="date-picker-option__label">{{item.label}}</text>
        <text class="date-picker-option__value">{{item.shortLabel}}</text>
      </view>
    </view>
  </view>

  <!-- Bottom Spacing for TabBar (handled by padding-bottom in CSS) -->
</view>
<guide-mask id="guideMask" g-trigger="{{gTrigger}}" g-steps="{{gSteps}}" g-accent="{{gAccent}}" />
