<!--订单详情页面-->
<view class="page-container">
  <view class="subpage-nav-bar" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
    <view class="subpage-nav-content" style="height: {{navBarHeight - statusBarHeight}}px;">
      <view class="subpage-nav-left">
        <view class="subpage-nav-back" bindtap="goBack">
          <view class="subpage-nav-back-icon"></view>
        </view>
        <text class="subpage-nav-title">订单详情</text>
      </view>
      <view class="order-detail-nav-right">
        <view class="status-badge" wx:if="{{order && order.itemStatus === 'DELIVERED'}}">已送达</view>
        <view class="status-badge status-badge-pending" wx:elif="{{order}}">待配送</view>
      </view>
    </view>
  </view>
  <view class="subpage-nav-spacer" style="height: {{navBarHeight}}px;"></view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="empty-state">
    <text class="material-symbols-outlined empty-icon">⌛</text>
    <text class="empty-text">加载中...</text>
  </view>

  <!-- 订单不存在 -->
  <view wx:elif="{{!order}}" class="empty-state">
    <text class="material-symbols-outlined empty-icon">!</text>
    <text class="empty-text">订单不存在</text>
  </view>

  <!-- Main Content -->
  <view wx:else class="main-content">
    <!-- 订单信息 -->
    <view class="detail-card address-card">
      <view class="card-header">
        <image class="card-head-icon" src="/assets/icons/location.svg" mode="aspectFit"></image>
        <text class="card-title">配送地址</text>
      </view>
      <view class="address-text" bindtap="handleCopyAddress">
        <text wx:if="{{order.district}}" class="address-district">{{order.district}}</text>
        <text class="address-detail">{{order.detail || order.deliveryAddress}}</text>
      </view>

      <!-- 客户信息：名字 + 联系/导航（放在地址下方、备注与参照图上方） -->
      <view class="customer-info">
        <view class="customer-details">
          <text class="customer-name">{{order.customerName}}{{order.quantity > 1 ? ' ×' + order.quantity : ''}}</text>
          <text class="customer-phone">{{order.customerPhone}}</text>
        </view>
        <view class="action-buttons">
          <view class="action-btn phone-btn" bindtap="handleCall">
            <image class="btn-icon" src="/assets/icons/phone.svg" mode="aspectFit"></image>
            <text class="btn-text">联系</text>
          </view>
          <view class="action-btn nav-btn" bindtap="handleNavigate">
            <image class="btn-icon" src="/assets/icons/navigation-white.svg" mode="aspectFit"></image>
            <text class="btn-text">导航</text>
          </view>
        </view>
      </view>

      <!-- 参考图：直接展示，无需点击查看；支持更改/上传 -->
      <view class="reference-summary-card">
        <view class="reference-summary-icon">
          <image class="reference-summary-icon-img" src="/assets/icons/image.svg" mode="aspectFit"></image>
        </view>
        <view class="reference-summary-copy">
          <text class="reference-summary-label">参考图</text>
          <text class="reference-summary-value" wx:if="{{hasReferenceImage}}">已保存，可更改或查看大图</text>
          <text class="reference-summary-value reference-summary-empty" wx:else>暂无参考图</text>
        </view>
        <view class="reference-summary-action" bindtap="handleUploadReferenceImage">
          {{referenceUploading ? '上传中...' : (hasReferenceImage ? '更改' : '上传')}}
        </view>
      </view>

      <!-- 参考图直接展示，无需点击即可看到 -->
      <view wx:if="{{hasReferenceImage && referenceImageUrl && !referenceImageError}}" class="reference-inline" bindtap="previewReferenceImage">
        <image
          class="reference-inline-img"
          src="{{referenceImageUrl}}"
          mode="aspectFill"
          lazy-load="{{true}}"
          binderror="onReferenceImageError"
        ></image>
        <view class="reference-inline-hint">
          <image class="reference-inline-hint-icon" src="/assets/icons/zoom.svg" mode="aspectFit"></image>
          <text class="reference-inline-hint-text">点击查看大图</text>
        </view>
      </view>

      <!-- 参考图加载失败兜底（原图已不可用），避免渲染层反复报 404 -->
      <view wx:elif="{{hasReferenceImage && !referenceImageLoading && referenceImageError}}" class="reference-empty" bindtap="handleUploadReferenceImage">
        <image class="reference-empty-icon" src="/assets/icons/camera.svg" mode="aspectFit"></image>
        <text class="reference-empty-title">参考图已失效</text>
        <text class="reference-empty-copy">原参考图无法加载，可重新上传一张。</text>
      </view>

      <view wx:elif="{{!referenceImageLoading}}" class="reference-empty" bindtap="handleUploadReferenceImage">
        <image class="reference-empty-icon" src="/assets/icons/camera.svg" mode="aspectFit"></image>
        <text class="reference-empty-title">暂无参考图</text>
        <text class="reference-empty-copy">首次送达的回执图会默认沉淀为参考图，也可以现在单独补一张。</text>
      </view>

      <view wx:else class="reference-loading">
        <text class="material-symbols-outlined">⌛</text>
        <text class="reference-loading-text">参考图加载中...</text>
      </view>

    </view>

    <!-- 订单备注：有任何备注（用户/商家）时独立成卡、醒目展示，骑手进详情第二眼就能看到 -->
    <view class="detail-card order-note-card" wx:if="{{order.customerNote || order.merchantNote}}">
      <view class="card-header">
        <image class="card-head-icon" src="/assets/icons/warning.svg" mode="aspectFit"></image>
        <text class="card-title">订单备注</text>
      </view>
      <view class="order-note-row" wx:if="{{order.customerNote}}">
        <text class="order-note-label">用户备注</text>
        <text class="order-note-value" user-select>{{order.customerNote}}</text>
      </view>
      <view class="order-note-row" wx:if="{{order.merchantNote}}">
        <text class="order-note-label order-note-label--merchant">商家备注</text>
        <text class="order-note-value" user-select>{{order.merchantNote}}</text>
      </view>
    </view>

    <!-- 送达信息 -->
    <view class="detail-card proof-section">
      <view class="card-header">
        <image class="card-head-icon" src="/assets/icons/check-green.svg" mode="aspectFit"></image>
        <text class="card-title">送达凭证</text>
      </view>

      <!-- 已送达且未进入编辑模式：显示已提交的回执 -->
      <view wx:if="{{order.itemStatus === 'DELIVERED' && !isEditingReceipt}}">
        <view class="delivered-receipt-view">
          <!-- 显示已提交的照片 -->
          <view class="submitted-photo" wx:if="{{order.receiptUrl}}">
            <image class="receipt-img" src="{{order.receiptUrl}}" mode="aspectFill" bindtap="previewPhoto"></image>
          </view>
          <view class="no-photo-hint" wx:else>
            <text class="material-symbols-outlined">⊘</text>
            <text>未上传照片</text>
          </view>

          <view class="submitted-note" wx:if="{{order.receiptNote}}">
            <text class="note-label">送达说明：</text>
            <text class="note-text">{{order.receiptNote}}</text>
          </view>

          <!-- 编辑按钮 -->
          <view class="receipt-actions">
            <button class="action-btn-secondary" bindtap="enterEditReceiptMode">
              <image class="btn-icon" src="/assets/icons/edit.svg" mode="aspectFit"></image>
              <text>编辑回执</text>
            </button>
            <button class="action-btn-danger" bindtap="handleUndoDelivery">
              <image class="btn-icon" src="/assets/icons/undo.svg" mode="aspectFit"></image>
              <text>撤回送达</text>
            </button>
          </view>
        </view>
      </view>

      <!-- 未送达或进入编辑模式：显示编辑表单 -->
      <view wx:else>
        <view class="proof-tip">
          {{isEditingReceipt ? '重新拍照或改说明，至少保留一项' : '上传照片或填写说明，至少提交一项'}}
        </view>

        <view class="photo-upload-area">
          <view class="photo-preview" wx:if="{{receiptTempFilePath}}">
            <image class="preview-img" src="{{receiptTempFilePath}}" mode="aspectFill" bindtap="previewPhoto"></image>
            <view class="photo-delete-btn" catchtap="removePhoto">
              <image class="photo-delete-icon" src="/assets/icons/close.svg" mode="aspectFit"></image>
            </view>
          </view>

          <view class="photo-upload-btn" bindtap="choosePhoto" wx:if="{{!receiptTempFilePath}}">
            <image class="upload-icon" src="/assets/icons/camera.svg" mode="aspectFit"></image>
            <text class="photo-upload-text">{{isEditingReceipt ? '点击重新拍照' : '点击拍摄送达照片'}}</text>
          </view>
        </view>

        <!-- Rider Note Input -->
        <view class="rider-note-area">
          <textarea
            class="rider-note-input"
            placeholder="{{isEditingReceipt ? '修改送达说明（选填）...' : '添加送达说明（选填）...'}}"
            value="{{receiptNote}}"
            bindinput="onReceiptNoteInput"
            maxlength="200"
            auto-height
          ></textarea>
        </view>
      </view>
    </view>

    <view class="detail-card detail-note-card detail-note-card--actions" wx:if="{{order.itemStatus !== 'DELIVERED' && !isEditingReceipt}}">
      <view class="detail-note-actions">
        <button class="action-btn-secondary" bindtap="handleDefer">
          <image class="btn-icon" src="/assets/icons/clock.svg" mode="aspectFit"></image>
          <text>稍后送这单</text>
        </button>
        <button class="action-btn-danger" bindtap="reportException">
          <image class="btn-icon" src="/assets/icons/alert.svg" mode="aspectFit"></image>
          <text>上报配送异常</text>
        </button>
      </view>
    </view>

    <!-- Bottom Spacing for Fixed Action Bar -->
    <view class="bottom-spacer"></view>

  </view>

  <view class="bottom-action-bar" wx:if="{{order}}">
    <!-- 未送达或编辑模式：显示操作按钮 -->
    <view wx:if="{{order.itemStatus !== 'DELIVERED' || isEditingReceipt}}" class="action-bar-buttons">
      <!-- 取消编辑按钮（仅编辑模式显示） -->
      <button
        class="cancel-btn"
        bindtap="cancelEditReceipt"
        wx:if="{{isEditingReceipt}}"
      >
        取消
      </button>

      <!-- 提交/更新按钮 -->
      <button
        class="submit-btn {{submitting ? 'disabled' : ''}} {{showSuccessAnim ? 'btn-success' : ''}}"
        disabled="{{submitting || showSuccessAnim}}"
        bindtap="handleSubmitReceipt"
      >
        <image wx:if="{{showSuccessAnim}}" class="success-check" src="/assets/icons/check-green.svg" mode="aspectFit"></image>
        <text wx:else>{{submitting ? (isEditingReceipt ? '更新中...' : '提交中...') : (isEditingReceipt ? '保存更新' : '确认送达')}}</text>
      </button>
    </view>

    <!-- 已送达且未编辑：显示已送达状态 -->
    <view class="delivered-status-btn" wx:else>
      <image class="delivered-check-icon" src="/assets/icons/check-green.svg" mode="aspectFit"></image>
      <text>该订单已送达</text>
    </view>
  </view>
<guide-mask id="guideMask" g-trigger="{{gTrigger}}" g-steps="{{gSteps}}" g-accent="{{gAccent}}" />

</view>
