page {
  background: var(--bg-page, #F5F5F7);
}

.register-shell {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 0 60rpx calc(env(safe-area-inset-bottom) + 40rpx);
}

/* Top Section */
.register-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 80rpx;
  margin-bottom: 64rpx;
}

.register-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.register-title {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--on-surface, #1B1B1D);
  margin-bottom: 16rpx;
}

.register-subtitle {
  font-size: 28rpx;
  color: var(--on-surface-variant, #475569);
}

/* Middle Section */
.register-main {
  flex: 1;
  width: 100%;
}

.register-form-group {
  background: var(--surface, #FFFFFF);
  border-radius: 24rpx;
  padding: 0 32rpx;
  margin-bottom: 40rpx;
  border: 1rpx solid var(--outline-variant, #E2E8F0);
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.04);
}

.register-form-item {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  border-bottom: 1rpx solid var(--outline-variant, #E2E8F0);
}

.register-form-item--last {
  border-bottom: none;
}

.register-label {
  width: 120rpx;
  font-size: 30rpx;
  color: var(--on-surface, #1B1B1D);
  font-weight: 600;
  flex-shrink: 0;
}

.register-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--on-surface, #1B1B1D);
  height: 88rpx;
  line-height: 88rpx;
  padding-left: 24rpx;
}

.register-placeholder {
  color: #cccccc;
}

/* Button */
.register-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: var(--primary, #2563EB);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 999rpx;
  border: none;
  margin: 0;
  padding: 0;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
}

.register-btn::after {
  border: none;
}

.register-btn[disabled] {
  opacity: 0.6;
}

/* Footer */
.register-footer {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  margin-top: 28rpx;
  font-size: 28rpx;
  color: var(--on-surface-variant, #475569);
}

.register-link {
  color: var(--primary, #2563EB);
  font-weight: 600;
  padding: 4rpx 8rpx;
}
