<view class="subpage-nav-bar" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
  <view class="subpage-nav-content" style="height: {{navBarHeight - statusBarHeight}}px;">
    <view class="subpage-nav-left">
      <view class="subpage-nav-back" bindtap="goBack">
        <view class="subpage-nav-back-icon"></view>
      </view>
      <text class="subpage-nav-title">骑手注册</text>
    </view>
    <view class="subpage-nav-right"></view>
  </view>
</view>
<view class="subpage-nav-spacer" style="height: {{navBarHeight}}px;"></view>

<view class="register-shell">
  <!-- Top Section: Logo and Welcome -->
  <view class="register-hero">
    <image class="register-logo" src="/assets/logo.jpeg" mode="aspectFill"></image>
    <view class="register-title">骑手注册</view>
    <view class="register-subtitle">首次使用，填写信息即可登记</view>
  </view>

  <!-- Middle Section: Forms and Button -->
  <view class="register-main">
    <view class="register-form-group">
      <view class="register-form-item">
        <text class="register-label">姓名</text>
        <input
          class="register-input"
          type="text"
          placeholder="请输入真实姓名"
          placeholder-class="register-placeholder"
          value="{{name}}"
          bindinput="onNameInput"
        />
      </view>
      <view class="register-form-item register-form-item--last">
        <text class="register-label">手机号</text>
        <input
          class="register-input"
          type="number"
          placeholder="请输入手机号"
          placeholder-class="register-placeholder"
          maxlength="11"
          value="{{phone}}"
          bindinput="onPhoneInput"
        />
      </view>
    </view>

    <button
      class="register-btn"
      loading="{{loading}}"
      disabled="{{loading}}"
      bindtap="onRegister"
    >{{loading ? '注册中...' : '注册'}}</button>

    <view class="register-footer">
      <text>已有账号？</text>
      <text class="register-link" bindtap="goToLogin">去登录</text>
    </view>
  </view>
</view>
