.gm-root {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
}

.gm-dim {
  position: absolute;
  background: rgba(15, 23, 42, 0.55);
}

.gm-ring {
  position: absolute;
  box-sizing: border-box;
  border: 2px solid #ffffff;
  border-radius: 12px;
}

.gm-tip {
  position: absolute;
  background: #ffffff;
  border-radius: 14px;
  padding: 16px;
  box-sizing: border-box;
}

.gm-arrow {
  position: absolute;
  width: 0;
  height: 0;
}

.gm-arrow-top {
  bottom: -10px;
  border-left: 10px solid transparent;
  border-right: 10px solid transparent;
  border-top: 10px solid #ffffff;
}

.gm-arrow-bottom {
  top: -10px;
  border-left: 10px solid transparent;
  border-right: 10px solid transparent;
  border-bottom: 10px solid #ffffff;
}

.gm-count {
  font-size: 12px;
  color: #94a3b8;
  margin-bottom: 8px;
  text-align: right;
}

.gm-tip-title {
  font-size: 14px;
  font-weight: 500;
  color: #0f172a;
  margin-bottom: 6px;
}

.gm-tip-desc {
  font-size: 13px;
  color: #475569;
  line-height: 1.5;
}

.gm-tip-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14px;
}

.gm-skip {
  font-size: 13px;
  color: #94a3b8;
}

.gm-next {
  font-size: 13px;
  font-weight: 500;
  color: #ffffff;
  border-radius: 18px;
  padding: 8px 18px;
}

/* 演示模式：蒙层不拦截点击，用户可真实点进页面元素 */
.gm-root--interactive {
  pointer-events: none;
}

.gm-root--interactive .gm-dim {
  background: rgba(15, 23, 42, 0.12);
}

.gm-root--interactive .gm-ring {
  pointer-events: none;
}

.gm-root--interactive .gm-tip {
  pointer-events: auto;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.18);
}
