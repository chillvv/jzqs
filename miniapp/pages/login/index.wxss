page {
  background: var(--bg-card);
  --brand-primary: #07c160;
  --brand-secondary: #f2f2f2;
  --text-main: #333333;
  --text-sub: #999999;
  --text-link: #576b95;
}

.auth-page-shell {
  min-height: calc(100vh - 88px);
  overflow-y: auto;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 0 60rpx calc(env(safe-area-inset-bottom) + 40rpx);
  position: relative;
}

/* Top Section */
.auth-page-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.auth-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.auth-page-title {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

.auth-page-subtitle {
  font-size: 28rpx;
  color: var(--text-sub);
}

/* Middle Section */
.auth-page-main {
  flex: 1;
  width: 100%;
}

.auth-form-group {
  margin-bottom: 40rpx;
}

.auth-form-item {
  display: flex;
  align-items: center;
  height: 100rpx;
  border-bottom: 1rpx solid var(--border);
  transition: border-color 0.3s;
}

.auth-form-item:focus-within {
  border-bottom-color: var(--brand-primary);
}

.auth-form-input {
  flex: 1;
  font-size: 32rpx;
  color: var(--text-main);
  height: 100%;
}

.auth-input-placeholder {
  color: #cccccc;
}

.phone-hint {
  margin-top: -20rpx;
  margin-bottom: 40rpx;
  font-size: 26rpx;
  color: var(--text-sub);
}

.phone-hint-val {
  color: var(--text-main);
  font-weight: 500;
}

.auth-name-hint {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.6;
}

/* Buttons */
.auth-btn {
  width: 320rpx !important;
  min-width: 320rpx;
  max-width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  padding: 0;
  margin-bottom: 32rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.auth-btn::after {
  border: none;
}

.auth-btn-primary {
  background: var(--brand-primary);
  color: #ffffff;
}

.auth-btn-primary[disabled] {
  background: #a0e5b8 !important;
  color: var(--bg-card) !important;
}

.auth-btn-secondary {
  background: var(--brand-secondary);
  color: var(--text-main);
}

.auth-btn-secondary[disabled] {
  background: #f7f7f7 !important;
  color: #cccccc !important;
}

/* Links */
.auth-links {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 20rpx;
}

.auth-link {
  font-size: 28rpx;
  color: var(--text-link);
  padding: 10rpx 20rpx;
}

.auth-link-divider {
  font-size: 24rpx;
  color: #e5e5e5;
  margin: 0 10rpx;
}

/* Bottom Section */
.auth-page-footer {
  width: 100%;
  padding-top: 24rpx;
}

.auth-agreement-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
}

.auth-agreement-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #c8c8c8;
  background: #ffffff;
  box-sizing: border-box;
  margin-right: 14rpx;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.auth-agreement-icon.checked {
  border-color: var(--brand-primary);
  background: var(--brand-primary);
}

.auth-agreement-icon-mark {
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
}

.auth-agreement-copy-line {
  font-size: 24rpx;
  color: var(--text-sub);
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  line-height: 1.6;
}

.auth-agreement-text {
  font-size: 24rpx;
  color: var(--text-sub);
}

.auth-agreement-link {
  font-size: 24rpx;
  color: var(--text-link);
  padding: 0 2rpx;
}

/* 未勾选时点击登录的提醒动画 */
.auth-agreement-bar.attention {
  animation: agreementShake 0.5s ease;
}

.auth-agreement-bar.attention .auth-agreement-icon {
  border-color: #fa5151;
  background: #fff5f5;
}

@keyframes agreementShake {
  0%, 100% { transform: translateX(0); }
  15% { transform: translateX(-10rpx); }
  30% { transform: translateX(10rpx); }
  45% { transform: translateX(-8rpx); }
  60% { transform: translateX(8rpx); }
  75% { transform: translateX(-4rpx); }
  90% { transform: translateX(4rpx); }
}
