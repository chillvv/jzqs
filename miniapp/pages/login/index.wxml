<subpage-navbar title="{{authFlowMode === 'complete-profile' ? '完善资料' : '登录'}}" />

<view class="auth-page-shell" style="min-height: calc(100vh - {{navBarHeight}}px);">
  <!-- Top Section: Logo and Welcome -->
  <view class="auth-page-hero" style="margin-top: 40rpx;">
    <image class="auth-logo" src="/assets/logo.jpeg" mode="aspectFill"></image>
    <view class="auth-page-title">{{authFlowMode === 'complete-profile' ? '填写姓名完成注册' : '欢迎登录'}}</view>
    <view class="auth-page-subtitle">{{authFlowMode === 'complete-profile' ? '名字会展示给商家，请尽量填写真实姓名，方便为您备餐与配送' : '为了保障您的账号安全，请使用手机号快捷登录'}}</view>
  </view>

  <!-- Middle Section: Forms and Buttons -->
  <view class="auth-page-main">
    <view class="phone-hint" wx:if="{{phoneAuthHint}}">
      已验证手机号：<text class="phone-hint-val">{{phoneAuthHint}}</text>
    </view>

    <view class="auth-form-group" wx:if="{{authFlowMode === 'complete-profile'}}">
      <view class="auth-form-item">
        <input class="auth-form-input" type="nickname" maxlength="20" placeholder="请输入您的姓名（建议实名）" value="{{profileForm.nickname}}" bindinput="onNicknameInput" placeholder-class="auth-input-placeholder" />
      </view>
      <view class="auth-name-hint">姓名与手机号均不可重复，若提示已存在请更换</view>
    </view>

    <block wx:if="{{authFlowMode === 'login'}}">
      <button
        wx:if="{{agreementAccepted}}"
        class="auth-btn auth-btn-primary"
        open-type="getPhoneNumber"
        bindtap="prepareWechatLogin"
        bindgetphonenumber="getPhoneNumber"
        loading="{{wechatLoading}}"
        disabled="{{savingProfile || wechatLoading}}"
      >
        手机号快捷登录
      </button>
      <button
        wx:else
        class="auth-btn auth-btn-primary"
        bindtap="handleLoginNeedAgreement"
        loading="{{wechatLoading}}"
        disabled="{{savingProfile || wechatLoading}}"
      >
        手机号快捷登录
      </button>

      <view class="auth-links">
        <view class="auth-link" bindtap="goBack">暂不登录</view>
      </view>
    </block>

    <block wx:else>
      <button
        class="auth-btn auth-btn-primary"
        loading="{{savingProfile}}"
        disabled="{{savingProfile}}"
        bindtap="handleSubmitEntry"
      >完成注册</button>
    </block>
  </view>

  <!-- Bottom Section: Agreement -->
  <view class="auth-page-footer">
    <view class="auth-agreement-bar {{agreementAttention ? 'attention' : ''}}" bindtap="toggleAgreement">
      <view class="auth-agreement-icon {{agreementAccepted ? 'checked' : ''}}">
        <text wx:if="{{agreementAccepted}}" class="auth-agreement-icon-mark">✓</text>
      </view>
      <view class="auth-agreement-copy-line">
        <text class="auth-agreement-text">我已阅读并同意</text>
        <text class="auth-agreement-link" catchtap="openAgreement">《用户协议》</text>
        <text class="auth-agreement-text">与</text>
        <text class="auth-agreement-link" catchtap="openPrivacy">《隐私政策》</text>
      </view>
    </view>
  </view>
</view>
