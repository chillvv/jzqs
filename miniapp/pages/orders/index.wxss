.order-card {
  padding: 0;
  border-radius: 32rpx;
  background: var(--bg-card);
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04);
  margin-bottom: 20rpx;
  border: 2rpx solid #fdfdfd;
}

.order-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  background: #fdfdfd;
  border-bottom: 2rpx dashed #f1f5f9;
}

.order-time-wrap {
  display: flex;
  align-items: center;
}

.order-time {
  font-size: 28rpx;
  color: #475569;
  font-weight: 700;
}

/* 状态胶囊：左侧圆点 + 浅色底，颜色语义与项目橄榄绿主题协调 */
.order-status {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  text-align: right;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #64748b;
}

.order-status::before {
  content: '';
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  background: currentColor;
}

/* 待配送 —— 琥珀色，提示"还在路上" */
.order-status.pending { color: #b45309; background: #fef6e7; }
/* 已送达 —— 品牌橄榄绿，闭环完成 */
.order-status.delivered { color: #5f7a24; background: var(--brand-light); }
/* 售后处理中 —— 蓝色，中性等待 */
.order-status.aftersale { color: #1d4ed8; background: #eef4ff; }
/* 已退款 / 售后未通过 —— 红色，需要用户注意 */
.order-status.refunded,
.order-status.rejected { color: #b42318; background: #fdf0ef; }
/* 已取消 —— 灰色，弱化 */
.order-status.cancelled { color: #94a3b8; background: #f4f5f7; }

.detail-icon {
  margin-left: 4rpx;
  font-weight: 400;
}

.order-card-body {
  padding: 32rpx;
}

.order-main-info {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.order-meal-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  flex: 1;
  line-height: 1.4;
}

/* 份数不再单独占一行，跟在菜名右侧 */
.order-qty {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--brand-dark);
  flex-shrink: 0;
}

.order-detail-list {
  background: var(--bg-card-alt);
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  font-size: 26rpx;
  line-height: 1.6;
}

.detail-label {
  color: #999999;
  width: 130rpx;
  flex-shrink: 0;
  font-weight: 400;
}

.detail-value {
  color: #444444;
  flex: 1;
  word-break: break-all;
  font-weight: 400;
}

.rider-phone {
  color: #92AA40;
  font-weight: 600;
  text-decoration: underline;
}

/* 骑手电话右对齐，并补充"优先联系骑手"的温馨提醒 */
.rider-phone-row .rider-phone {
  text-align: right;
}

.rider-tip {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 4rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #fff7ed;
  border: 2rpx solid #fde9c8;
}

.rider-tip-icon {
  font-size: 26rpx;
  line-height: 1.5;
  flex-shrink: 0;
}

.rider-tip-text {
  font-size: 22rpx;
  color: #b45309;
  line-height: 1.5;
  font-weight: 500;
}

.highlight-note {
  color: #d97706;
  font-weight: 600;
}

.order-card-footer {
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #f1f5f9;
  display: flex;
  justify-content: center;
}

.action-btn-group {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.action-btn {
  margin: 0;
  padding: 0 36rpx;
  height: 64rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
}

.action-btn::after {
  border: none;
}

.action-btn.outline {
  background: var(--bg-card);
  color: #475569;
  border: 2rpx solid #cbd5e1;
}

.action-btn.primary {
  background: var(--brand-color);
  color: #ffffff;
  border: 2rpx solid var(--brand-color);
  box-shadow: 0 4rpx 12rpx rgba(146, 170, 64, 0.2);
}

.target-order-hint {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  font-size: 24rpx;
  color: #64748b;
}

.target-order-btn {
  min-width: 188rpx;
}

/* Empty state styles */
.empty-state-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}
.empty-title {
  font-size: 32rpx;
  color: var(--text-main);
  font-weight: 800;
  margin-bottom: 16rpx;
}
.empty-desc {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-bottom: 40rpx;
}
.btn-go-order {
  background: var(--brand-primary);
  color: #111;
  border: none;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 64rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 20rpx rgba(184, 208, 96, 0.2);
}
