<subpage-navbar title="{{selectOrderId ? '选择配送地址' : '收餐地址管理'}}" />

<view class="subpage">
  <view wx:if="{{selectOrderId}}" class="subpage-card">
    <view class="subpage-subtitle">请选择一个已保存地址，用于替换当前订单的配送地址</view>
  </view>

  <view wx:if="{{items.length}}">
    <view wx:for="{{items}}" wx:key="id" class="subpage-card addr-card">
      <view class="addr-head">
        <view class="addr-person">
          <text class="addr-name">{{item.contactName}}</text>
          <text class="addr-phone">{{item.contactPhone}}</text>
        </view>
        <view wx:if="{{item.isDefault}}" class="status-pill-default">默认</view>
      </view>
      <view class="addr-detail">
        <text wx:if="{{item.district}}" class="addr-district">{{item.district}}</text>
        <text class="addr-detail-main">{{item.detail}}{{item.doorNumber ? ' ' + item.doorNumber : ''}}</text>
      </view>
      <view class="addr-actions">
        <block wx:if="{{selectOrderId}}">
          <button wx:if="{{!item.isCurrentOrderAddress}}" class="addr-action addr-action-primary" data-id="{{item.id}}" bindtap="selectAddressForOrder">使用这个地址</button>
          <text wx:else class="addr-action-current">当前配送地址</text>
        </block>
        <block wx:else>
          <button wx:if="{{!item.isDefault}}" class="addr-action" data-id="{{item.id}}" bindtap="setDefault">设为默认</button>
          <button class="addr-action" data-id="{{item.id}}" bindtap="editAddress">编辑</button>
          <button class="addr-action addr-action-danger" data-id="{{item.id}}" bindtap="deleteAddress">删除</button>
        </block>
      </view>
    </view>
  </view>

  <view wx:elif="{{!loading}}" class="subpage-card">
    <view class="empty-text">还没有保存任何地址</view>
  </view>

  <button class="sub-btn primary full-btn" style="margin-top: 40rpx;" bindtap="showAddPopup" disabled="{{addressLimitReached}}">{{addressLimitReached ? '已达 5 个上限，请先删除' : (selectOrderId ? '+ 新增后使用' : '+ 新增地址')}}</button>

  <!-- 新增/编辑地址半屏弹窗 -->
  <view class="address-popup-mask {{showPopup ? 'show' : ''}}" bindtap="hideAddPopup"></view>
  <view class="address-popup-container {{showPopup ? 'show' : ''}}">
    <view class="popup-header">
      <view class="popup-title">{{form.id ? '编辑地址' : '新增地址'}}</view>
      <view class="popup-close" bindtap="hideAddPopup">×</view>
    </view>

    <scroll-view scroll-y class="popup-body" enhanced show-scrollbar="{{false}}">
      <!-- 当前用户 -->
      <view class="user-row">
        <text class="user-name">{{customerProfile.name || '未设置姓名'}}</text>
        <text class="user-phone">{{customerProfile.phone || ''}}</text>
      </view>

      <!-- 地图选点（整块可点击） -->
      <view class="locate-card" bindtap="chooseLocation" hover-class="locate-card--hover">
        <view class="locate-icon-wrap">
          <text class="locate-icon">📍</text>
        </view>
        <view class="locate-content">
          <view class="locate-title">{{form.latitude ? '已定位 · 点击重新选点' : '点击地图选点定位'}}</view>
          <view class="locate-sub">{{form.latitude ? '位置已锁定，可继续编辑详细地址' : '骑手根据定位精准送达'}}</view>
        </view>
        <view class="locate-arrow">›</view>
      </view>

      <!-- 定位地址（只读，选点自动填充） -->
      <view class="form-block">
        <view class="form-label">定位地址</view>
        <view class="locate-address-readonly">{{form.addressLine || '选点后自动填充'}}</view>
      </view>

      <!-- 门牌号 -->
      <view class="form-block">
        <view class="form-label">门牌号</view>
        <view class="input-wrap">
          <input class="detail-input" data-field="doorNumber" value="{{form.doorNumber}}" bindinput="onInputChange" placeholder="如：1栋2单元3004，可备注放门口" placeholder-style="font-size:28rpx;color:#bbb;" />
        </view>
      </view>

      <!-- 默认地址 -->
      <view class="switch-row">
        <text class="switch-label">设为默认地址</text>
        <switch checked="{{form.isDefault}}" color="#92AA40" bindchange="onDefaultChange" />
      </view>
    </scroll-view>

    <view class="popup-footer">
      <button class="save-btn" bindtap="saveAddress" loading="{{saving}}" disabled="{{saving}}">保存地址</button>
    </view>
  </view>
</view>