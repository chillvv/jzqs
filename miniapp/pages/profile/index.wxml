<!-- =====================================
      Tab 3：我的页
      ===================================== -->
<view class="custom-nav-bar" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px; background: transparent; backdrop-filter: none; -webkit-backdrop-filter: none; position: absolute;">
  <view class="custom-nav-left">
    <image class="custom-nav-logo" src="/assets/logo.jpeg" mode="aspectFit"></image>
    <text class="custom-nav-title">简知轻食</text>
  </view>
</view>

<view id="tab-profile" class="content">
  <view class="profile-header" style="padding-top: calc({{navBarHeight}}px + 40rpx);">
    <view class="profile-meta">
      <view class="profile-name" bindtap="goEditProfile">
        {{displayName}}
        <text wx:if="{{!onboarding}}" class="edit-icon">✎</text>
      </view>
      <view class="profile-sub" wx:if="{{!onboarding}}">{{maskedPhone}}</view>
      <view class="profile-guest-action" wx:if="{{onboarding}}" bindtap="goLoginPage">
        去登录 <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <view class="vip-card" wx:if="{{!onboarding}}">
    <view class="vip-title">当前剩余餐数</view>
    <view class="vip-balance"><text class="num">{{home ? home.remainingMeals : '--'}}</text><text class="unit">餐</text></view>
    <view class="vip-submeta" wx:if="{{home && home.packageExpiredAt}}">
      <view class="member-copy member-copy--compact">到期日：{{home.packageExpiredAt}}</view>
      <view class="vip-validity-line" wx:if="{{home.remainingValidityDays >= 0}}">
        <text class="member-copy member-copy--compact">剩余 </text>
        <text class="vip-validity-days">{{home.remainingValidityDays}}</text>
        <text class="member-copy member-copy--compact"> 天</text>
      </view>
    </view>
    <view class="member-copy" wx:else>会员预订专享</view>
    <view class="vip-alert" wx:if="{{home && home.packageAlertMessage}}">{{home.packageAlertMessage}}</view>
    <view class="vip-footer">
      <view class="vip-status">会员预订专享</view>
      <view class="btn-outline" bindtap="goWallet">餐次流水单</view>
    </view>
  </view>

  <view class="menu-group">
    <view class="list-item {{onboarding ? 'disabled' : ''}}" bindtap="goOrders">
      <view class="list-icon-wrap">
        <text class="list-icon">📝</text>
        <view class="list-copy">
          <view class="list-title">我的预订记录</view>
        </view>
      </view>
      <text class="list-arrow">›</text>
    </view>
    <view class="list-item {{onboarding ? 'disabled' : ''}}" bindtap="goReceipts">
      <view class="list-icon-wrap">
        <text class="list-icon">📸</text>
        <view class="list-copy">
          <view class="list-title">每日送达回执</view>
        </view>
      </view>
      <text class="list-arrow">›</text>
    </view>
  </view>

  <view class="menu-group">
    <view class="list-item {{onboarding ? 'disabled' : ''}}" bindtap="goAddresses">
      <view class="list-icon-wrap">
        <text class="list-icon">📍</text>
        <view class="list-copy">
          <view class="list-title">收餐地址管理</view>
        </view>
      </view>
      <text class="list-arrow">›</text>
    </view>
    <button class="list-item list-item-btn {{onboarding ? 'disabled' : ''}}" bindtap="contactService" open-type="{{onboarding ? '' : 'contact'}}">
      <view class="list-icon-wrap">
        <text class="list-icon">💬</text>
        <view class="list-copy">
          <view class="list-title">联系专属客服</view>
        </view>
      </view>
      <text class="list-arrow">›</text>
    </button>
    <view class="list-item" bindtap="onNewbieGuideTap">
      <view class="list-icon-wrap">
        <text class="list-icon">🧭</text>
        <view class="list-copy">
          <view class="list-title">新手指引</view>
        </view>
      </view>
      <text class="list-arrow">›</text>
    </view>
  </view>

  <view class="menu-group" wx:if="{{!onboarding && showTestSubscription}}">
    <button class="list-item list-item-btn {{sendingDelivery ? 'disabled' : ''}}" data-template="delivery" bindtap="sendSubscriptionTest" loading="{{sendingDelivery}}">
      <view class="list-icon-wrap">
        <text class="list-icon">🔔</text>
        <view class="list-copy">
          <view class="list-title">测试送达订阅</view>
        </view>
      </view>
      <text class="list-arrow">›</text>
    </button>
    <button class="list-item list-item-btn {{sendingNightly ? 'disabled' : ''}}" data-template="nightly" bindtap="sendSubscriptionTest" loading="{{sendingNightly}}">
      <view class="list-icon-wrap">
        <text class="list-icon">🌙</text>
        <view class="list-copy">
          <view class="list-title">测试提醒订阅</view>
        </view>
      </view>
      <text class="list-arrow">›</text>
    </button>
  </view>

  <view class="logout-section" wx:if="{{!onboarding}}">
    <button class="btn-logout" bindtap="handleLogout">退出登录</button>
  </view>

  <view class="tabbar-spacer"></view>

</view>

<guide-swiper id="guideSwiper" bind:done="onGuideDone" bind:skip="onGuideSkip" />
<guide-mask id="guideMask" g-trigger="{{gTrigger}}" g-steps="{{gSteps}}" g-accent="{{gAccent}}" />

