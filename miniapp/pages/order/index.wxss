/* pages/order/index.wxss */

.rule-card {
  margin: 0 24rpx 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, var(--bg-card) 0%, #f7f9ee 100%);
  box-shadow: var(--shadow-sm);
}

.rule-card__title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-main);
}

.rule-card__item {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-sub);
}

.inline-auth-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.48);
  opacity: 0;
  visibility: hidden;
  transition: all 0.2s ease;
  z-index: 1001;
}

.inline-auth-mask.show {
  opacity: 1;
  visibility: visible;
}

.inline-auth-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 160rpx;
  padding: 40rpx 32rpx;
  border-radius: 40rpx 40rpx 0 0;
  background: var(--bg-card);
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.1);
  transform: translateY(120%);
  transition: transform 0.24s cubic-bezier(0.175, 0.885, 0.32, 1.1);
  z-index: 1002;
}

.inline-auth-sheet.show {
  transform: translateY(0);
}

.inline-auth-sheet__header {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: flex-start;
}

.inline-auth-sheet__title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-main);
}

.inline-auth-sheet__desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-sub);
}

.inline-auth-sheet__close {
  font-size: 40rpx;
  line-height: 1;
  color: var(--text-muted);
  padding: 4rpx 0 0 12rpx;
}

.inline-auth-sheet__primary,
.inline-auth-sheet__secondary {
  margin-top: 24rpx;
  width: 100%;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.inline-auth-sheet__primary {
  background: var(--brand-primary);
  color: #111111;
}

.inline-auth-sheet__secondary {
  background: var(--bg-card);
  color: var(--text-main);
  border: 2rpx solid var(--border);
}

.inline-auth-sheet__primary::after,
.inline-auth-sheet__secondary::after {
  border: none;
}

.remark-default-card {
  background: #f8fafc;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.remark-default-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.remark-default-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-main);
}

.remark-default-value {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-sub);
}

.remark-default-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* =========================================
   Tab 2：点餐页 + 购物车 + 结算（从 app.wxss 拆入）
   ========================================= */
/* 点餐页根容器固定整屏，禁止页面整体上下滚动；
   这样新手指引聚焦元素（如底部购物车按钮）时不会把整页滚走、顶部留白。
   菜单视图与结算视图各自内部滚动（内容超高时才滚，常规屏不滚）。 */
page { overflow: hidden; }

#tab-order {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
}

#view-menu {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
}

#view-checkout {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  /* 结算视图底边 = 自定义 tabBar 顶边（tabBar height 固定 160rpx，border-box 已含底部安全区），
     这样底部按钮栏贴死 tabBar 上边、任何机型都无缝，不靠硬编码 safe-area 去猜 */
  bottom: 160rpx;
  background: var(--bg-card);
  display: flex;
  flex-direction: column;
}

/* 头部（标题 / 夜间横幅）固定，仅餐品列表内部可滚动 */
.menu-list-wrap {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  display: flex;
  flex-direction: column;
  gap: 48rpx;
  /* 底部避让：tabBar 160rpx + 购物车栏悬浮间距 24rpx + 购物车栏高 112rpx（tabBar 160 已含安全区，不再额外加 safe） */
  padding: 0 24rpx calc(160rpx + 24rpx + 112rpx);
}
#view-checkout { background: var(--bg-app); }

.menu-top { background: var(--bg-card); padding: 32rpx; margin-bottom: 24rpx; }
.menu-top-title { font-size: 40rpx; font-weight: 800; margin-bottom: 8rpx; color: var(--text-main); }
.menu-top-desc { font-size: 26rpx; color: var(--text-sub); }
.menu-top-row { display: flex; align-items: center; gap: 16rpx; margin-top: 8rpx; }
.date-tag { background: #f0f4e8; color: var(--brand-color); font-size: 24rpx; font-weight: 700; padding: 4rpx 16rpx; border-radius: 8rpx; }

.rest-card { background: var(--bg-card); border: 2rpx dashed rgba(184, 208, 96, 0.3); border-radius: 32rpx; padding: 48rpx; text-align: center; color: var(--text-sub); font-size: 28rpx; font-weight: 500; margin-bottom: 32rpx; box-shadow: var(--shadow-sm); }

/* 夜间停单提示横幅 */
.night-close-banner {
  margin: 0 24rpx 24rpx;
  padding: 28rpx 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #eef3ff 0%, #f4f0fb 100%);
  border: 2rpx solid rgba(146, 170, 64, 0.18);
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  box-shadow: var(--shadow-sm);
}
.night-close-icon { font-size: 44rpx; line-height: 1.2; flex-shrink: 0; }
.night-close-body { flex: 1; min-width: 0; }
.night-close-title { font-size: 30rpx; font-weight: 800; color: var(--text-main); margin-bottom: 8rpx; }
.night-close-desc { font-size: 24rpx; line-height: 1.7; color: var(--text-sub); }

.meal-item { background: var(--bg-card); border-radius: 32rpx; padding: 32rpx; display: flex; gap: 24rpx; box-shadow: var(--shadow-sm); position: relative; border: 2rpx solid #fcfcfc; }
.meal-img { width: 180rpx; height: 180rpx; border-radius: 32rpx; flex-shrink: 0; display: block; border: 1rpx solid rgba(0, 0, 0, 0.04); background-color: #f8f8f8; box-shadow: inset 0 2rpx 8rpx rgba(0,0,0,0.04); }
.meal-content { flex: 1; display: flex; flex-direction: column; justify-content: space-between; min-width: 0; }
.meal-title { font-size: 40rpx; font-weight: 900; color: var(--text-main); margin-bottom: 8rpx; letter-spacing: 1rpx; }
.meal-desc { font-size: 24rpx; color: var(--text-sub); line-height: 1.8; margin-bottom: 20rpx; }
.meal-tags { display: flex; flex-wrap: wrap; gap: 8rpx; }
.meal-tag { font-size: 20rpx; background: #f7f8f2; color: var(--brand-dark); padding: 4rpx 14rpx; border-radius: 8rpx; font-weight: 700; }
.meal-bottom { display: flex; justify-content: flex-end; align-items: flex-end; margin-top: 16rpx; }
.stepper { display: flex; align-items: center; background: var(--bg-card); border: 1rpx solid #f0f0f0; border-radius: 32rpx; padding: 4rpx; transition: border-color 0.3s; }
.stepper.active { background: var(--bg-card); border-color: var(--brand-dark); }
.step-btn { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; font-size: 38rpx; font-weight: 200; color: var(--text-main); transition: transform 0.15s cubic-bezier(0.4, 0, 0.2, 1); }
.step-btn:active { transform: scale(0.9); }
.step-btn.minus { color: var(--text-muted); }
.step-btn.plus { color: var(--brand-dark); font-weight: 400; }
.step-num { min-width: 60rpx; text-align: center; font-size: 30rpx; font-weight: 600; color: var(--text-main); }

/* 购物车底栏 */
.cart-bar { position: fixed; bottom: 184rpx; left: 32rpx; right: 32rpx; height: 112rpx; background: linear-gradient(135deg, rgba(40, 40, 40, 0.7) 0%, rgba(10, 10, 10, 0.85) 100%); backdrop-filter: blur(40px); -webkit-backdrop-filter: blur(40px); border: 2rpx solid rgba(255, 255, 255, 0.15); border-radius: 56rpx; display: flex; align-items: center; justify-content: space-between; padding: 0 12rpx 0 40rpx; z-index: 100; transform: translateY(200rpx); visibility: hidden; opacity: 0; transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); box-shadow: 0 16rpx 40rpx rgba(0,0,0,0.25); }
.cart-bar.show { transform: translateY(0); visibility: visible; opacity: 1; }
.cart-info { display: flex; align-items: baseline; gap: 12rpx; }
.cart-total { font-size: 44rpx; font-weight: 900; color: var(--brand-primary); }
.cart-total text { font-size: 24rpx; margin-left: 4rpx; color: var(--brand-primary); }
.cart-desc { font-size: 24rpx; color: rgba(255, 255, 255, 0.95); font-weight: 900; }
.btn-checkout { background: var(--brand-primary); color: #111; border: none; height: 88rpx; line-height: 88rpx; padding: 0 48rpx; border-radius: 44rpx; font-size: 30rpx; font-weight: 900; margin: 0; }
.btn-checkout[disabled] { opacity: 0.5; background: var(--text-sub); color: var(--text-muted); }

/* 结算视图 */
.checkout-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.6);
  padding: 0 24rpx;
  z-index: 120;
  box-sizing: border-box;
}

.checkout-scroll {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 24rpx;
  padding-bottom: 32rpx;
}

.address-card { background: linear-gradient(180deg, var(--bg-card) 0%, #fdfdfd 100%); border-radius: 32rpx; padding: 40rpx; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; box-shadow: 0 12rpx 32rpx rgba(0,0,0,0.06); margin: 24rpx; border: 2rpx solid rgba(184, 208, 96, 0.15); position: relative; overflow: hidden; }
.address-card::before { content: ''; position: absolute; left: 0; bottom: 0; right: 0; height: 6rpx; background: repeating-linear-gradient(45deg, var(--brand-primary) 0, var(--brand-primary) 20rpx, transparent 20rpx, transparent 32rpx, #ffb347 32rpx, #ffb347 52rpx, transparent 52rpx, transparent 64rpx); opacity: 0.6; }
.addr-empty { font-size: 34rpx; font-weight: 800; color: var(--brand-dark); }
.addr-detail { font-size: 32rpx; font-weight: 800; color: var(--text-main); margin-bottom: 8rpx; display: flex; align-items: flex-start; gap: 16rpx; line-height: 1.5; }
.addr-tag { display: none; }
.addr-user { font-size: 26rpx; color: var(--text-sub); font-weight: 500; }
.addr-left-icon { font-size: 40rpx; margin-right: -8rpx; }
.addr-content { flex: 1; min-width: 0; }
.change-text { font-size: 26rpx; color: var(--brand-dark); font-weight: 700; }

.order-summary-card { background: var(--bg-card); border-radius: 32rpx; padding: 32rpx; box-shadow: var(--shadow-sm); margin-bottom: 24rpx; border: 2rpx solid #fdfdfd; }
.osc-title { font-size: 32rpx; font-weight: 800; border-bottom: 2rpx dashed var(--border); padding-bottom: 24rpx; margin-bottom: 24rpx; display: flex; justify-content: space-between; }
.osc-title .date { font-size: 26rpx; color: var(--text-sub); font-weight: normal; }

.checkout-item { display: flex; gap: 24rpx; margin-bottom: 32rpx; }
.checkout-item:last-child { margin-bottom: 0; }
.ci-img { width: 112rpx; height: 112rpx; border-radius: 20rpx; display: block; flex-shrink: 0; background-color: #e8e8e8; }
.ci-info { flex: 1; }
.ci-name { font-size: 30rpx; font-weight: 700; color: var(--text-main); margin-bottom: 8rpx; }
.ci-desc { font-size: 24rpx; color: var(--text-muted); margin-bottom: 16rpx; }
.ci-bottom { display: flex; justify-content: space-between; align-items: center; }
.ci-qty { font-size: 26rpx; color: var(--text-sub); }
.ci-price { font-size: 30rpx; font-weight: 800; color: var(--text-main); }

.checkout-row-card { background: var(--bg-card); border-radius: 32rpx; box-shadow: var(--shadow-sm); margin-bottom: 24rpx; border: 2rpx solid #fdfdfd; }
.checkout-row { padding: 32rpx; display: flex; justify-content: space-between; align-items: center; border-bottom: 2rpx dashed var(--border); }
.checkout-row:last-child { border-bottom: none; }
.checkout-row-label { font-size: 30rpx; font-weight: 800; color: var(--text-main); }
.checkout-row-value { font-size: 28rpx; color: var(--text-muted); display: flex; align-items: center; gap: 8rpx; }
.checkout-row-value.remark-container { display: block; }

.remark-input { width: 100%; text-align: left; font-size: 28rpx; color: var(--text-main); background: #f8fafc; height: 76rpx; line-height: 76rpx; border-radius: 20rpx; padding: 0 24rpx; box-sizing: border-box; }

.remark-dropdown { position: absolute; top: 100%; right: 0; background: var(--bg-card); border: 2rpx solid var(--border); border-radius: 16rpx; box-shadow: var(--shadow-md); z-index: 100; max-height: 260rpx; overflow-y: auto; width: 400rpx; margin-top: 8rpx; display: block; }
.remark-dropdown-item { padding: 20rpx 24rpx; font-size: 26rpx; color: var(--text-main); border-bottom: 2rpx solid var(--border); text-align: left; }
.remark-dropdown-item:last-child { border-bottom: none; }
.remark-dropdown-item:active { background: #f5f6f7; }

.remark-preset-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.remark-history-block {
  margin-bottom: 20rpx;
}

.remark-history-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-muted);
  text-align: right;
  margin-bottom: 12rpx;
}

.remark-history-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 16rpx;
}

.remark-chip {
  padding: 10rpx 28rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  border: 2rpx solid transparent;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
  transition: all 0.2s ease;
}

.remark-chip.active {
  background: var(--brand-light);
  border-color: var(--brand-color);
  color: var(--brand-color);
}

.btn-set-default {
  background: #f8fafc;
  border: 2rpx solid transparent;
  color: #94a3b8;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  font-size: 20rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.btn-set-default.active {
  background: var(--brand-light);
  border-color: var(--brand-dark);
  color: var(--brand-dark);
}

.remark-chip-secondary {
  background: var(--bg-card);
  border-color: #e2e8f0;
}

.submit-bar {
  /* 与点餐页购物车栏 cart-bar 完全一致的悬浮圆角卡片外观（黑底 + 绿按钮），
     作为结算视图 flex 末尾元素，贴住 tabBar 上方 */
  flex-shrink: 0;
  margin: 24rpx 32rpx;
  height: 112rpx;
  background: linear-gradient(135deg, rgba(40, 40, 40, 0.7) 0%, rgba(10, 10, 10, 0.85) 100%);
  backdrop-filter: blur(40px);
  -webkit-backdrop-filter: blur(40px);
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 56rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12rpx 0 40rpx;
  box-shadow: 0 16rpx 40rpx rgba(0,0,0,0.25);
}
.submit-total { display: flex; align-items: baseline; gap: 12rpx; }
.submit-total-label { font-size: 24rpx; color: rgba(255, 255, 255, 0.95); font-weight: 900; }
.submit-total-num { font-size: 44rpx; font-weight: 900; color: var(--brand-primary); }
.submit-total-unit { font-size: 24rpx; color: rgba(255, 255, 255, 0.95); font-weight: 900; }
.btn-submit { background: var(--brand-primary); color: #111; border: none; height: 88rpx; line-height: 88rpx; padding: 0 48rpx; border-radius: 44rpx; font-size: 30rpx; font-weight: 900; margin: 0; }
.btn-submit[disabled] {
  opacity: 0.56;
}

/* 订阅授权引导勾选（嵌在餐具数量卡片内，作为卡片末项，紧贴餐具数量，不额外留缝） */
.subscribe-consent {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff7ed;
  border: 2rpx solid #fde2bd;
  border-radius: 24rpx;
  padding: 26rpx 28rpx;
  margin: 0 32rpx 32rpx;
  transition: background 0.2s ease, border-color 0.2s ease;
}
/* 已勾选（本单授权） */
.subscribe-consent.checked {
  background: #f4faf0;
  border-color: #d8ebc4;
}
/* 已长期开启（勾选「总是保持」） */
.subscribe-consent.opened {
  background: #f3faf0;
  border-color: var(--brand-color);
}
.subscribe-consent-check {
  width: 42rpx;
  height: 42rpx;
  border-radius: 10rpx;
  border: 3rpx solid #f0a23a;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
  color: #111;
  flex-shrink: 0;
}
.subscribe-consent.checked .subscribe-consent-check,
.subscribe-consent.opened .subscribe-consent-check {
  background: var(--brand-primary);
  border-color: var(--brand-primary);
  color: #111;
}
.subscribe-consent-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.subscribe-consent-title { font-size: 28rpx; font-weight: 800; color: #b45309; line-height: 1.4; }
.subscribe-consent.checked .subscribe-consent-title,
.subscribe-consent.opened .subscribe-consent-title { color: var(--brand-dark); }
.subscribe-consent-desc { font-size: 23rpx; color: #9a6b3a; line-height: 1.5; }
.subscribe-consent.checked .subscribe-consent-desc,
.subscribe-consent.opened .subscribe-consent-desc { color: var(--text-sub); }
.subscribe-consent-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  background: var(--brand-color);
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  align-self: flex-start;
}
/* 授权中加载态 */
.subscribe-consent.loading { opacity: 0.85; }
.subscribe-consent-spinner {
  width: 22rpx;
  height: 22rpx;
  border: 4rpx solid rgba(184, 208, 96, 0.35);
  border-top-color: var(--brand-primary);
  border-radius: 50%;
  display: block;
  animation: consent-spin 0.7s linear infinite;
}
@keyframes consent-spin { to { transform: rotate(360deg); } }

/* 地址半屏弹窗 */
.address-popup-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 999; opacity: 0; visibility: hidden; transition: all 0.2s ease; }
.address-popup-mask.show { opacity: 1; visibility: visible; }
.address-popup-container { position: fixed; bottom: 0; left: 0; right: 0; background: var(--bg-card); border-radius: 32rpx 32rpx 0 0; z-index: 1000; transform: translateY(100%); transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275); display: flex; flex-direction: column; max-height: 80vh; }
.address-popup-container.show { transform: translateY(0); }
.popup-header { display: flex; justify-content: space-between; align-items: center; padding: 32rpx; font-size: 32rpx; font-weight: 700; color: var(--text-main); border-bottom: 2rpx solid var(--border); }
.close-btn { font-size: 40rpx; color: var(--text-muted); padding: 0 16rpx; margin-right: -16rpx; line-height: 1; }
.popup-body { flex: 1; min-height: 300rpx; max-height: 50vh; padding: 0 32rpx; }
.address-item { padding: 32rpx 0; border-bottom: 2rpx solid var(--border); display: flex; justify-content: space-between; align-items: center; }
.address-item:last-child { border-bottom: none; }
.addr-info { flex: 1; padding-right: 24rpx; }
.address-select-indicator { width: 40rpx; height: 40rpx; border-radius: 50%; border: 3rpx solid var(--border); display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: border-color 0.2s ease, background-color 0.2s ease; }
.address-select-indicator.active { border-color: var(--brand-primary, #B8D060); background: var(--brand-primary, #B8D060); }
.address-select-icon { font-size: 24rpx; line-height: 1; color: #ffffff; font-weight: 700; }
.addr-detail-text { font-size: 30rpx; font-weight: 600; color: var(--text-main); margin-bottom: 8rpx; }
.check-icon { color: var(--brand-primary); font-size: 32rpx; font-weight: 700; }
.popup-footer { padding: 24rpx 32rpx; border-top: 2rpx solid var(--border); }
.btn-add-address { background: var(--brand-light); color: var(--brand-dark); border: 2rpx solid var(--brand-dark); border-radius: 44rpx; height: 88rpx; line-height: 84rpx; font-size: 30rpx; font-weight: 700; display: flex; justify-content: center; align-items: center; width: 100% !important; margin: 0; box-sizing: border-box; }

/* =========================================
   下单成功弹窗
   ========================================= */
.success-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.25s ease, visibility 0.25s ease;
  z-index: 2000;
}
.success-mask.show {
  opacity: 1;
  visibility: visible;
}
.success-card {
  width: 560rpx;
  background: var(--bg-card);
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.18);
  transform: translateY(24rpx) scale(0.96);
  transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
.success-mask.show .success-card {
  transform: translateY(0) scale(1);
}
.success-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--brand-light);
  color: var(--brand-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.success-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-bottom: 12rpx;
}
.success-desc {
  font-size: 26rpx;
  color: var(--text-sub);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 24rpx;
}
.success-tip {
  width: 100%;
  background: #fff7ed;
  border: 2rpx solid #fde9c8;
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 32rpx;
  box-sizing: border-box;
}
.success-tip-head {
  font-size: 24rpx;
  font-weight: 700;
  color: #b45309;
  margin-bottom: 10rpx;
}
.success-tip-body {
  font-size: 22rpx;
  color: #b45309;
  line-height: 1.6;
}
.success-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
}
.success-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
  padding: 0;
  margin: 0;
}
.success-btn::after {
  border: none;
}
.success-btn.ghost {
  background: #f5f6f7;
  color: var(--text-sub);
}
.success-btn.primary {
  background: var(--brand-primary);
  color: #111111;
  box-shadow: 0 8rpx 20rpx rgba(184, 208, 96, 0.25);
}
